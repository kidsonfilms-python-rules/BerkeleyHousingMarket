SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# Used by the testing CLI. RPC_URL can be either testnet URL above.
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# Frontend (safe to expose in the browser; never put private keys here)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Server-only delivery release listener (run with npm run deliveries:release-listener)
DELIVERY_CALLBACK_SECRET=replace-with-a-long-random-secret
DELIVERY_API_BASE=https://your-deployed-app.example
DELIVERY_CONFIRMATIONS=2
DELIVERY_POLL_INTERVAL_MS=15000
